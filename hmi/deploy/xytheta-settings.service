[Unit]
Description=XY-Theta local HMI settings API
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/rpi/xytheta-hmi/xytheta-settings-service.py
Restart=on-failure
RestartSec=3s
User=root
NoNewPrivileges=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
