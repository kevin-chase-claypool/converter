(P112 - bounded outer-index survey, no G54 write.)
(Requires a fresh P111 then a successful P100 Q5; start stationary at Q5 TMAG centroid.)
(Moves TMAG +X by the measured center-to-index radius, captures two A footprints, and stops at pass-two center.)

#<outer_radius> = 223.675804
#<a_search_degrees> = 4500.0
#<a_expected_spacing> = 4320.0
#<a_spacing_tolerance> = 10.0
#<a_maximum_width> = 120.0
#<xy_travel_feed> = 1000.0
#<a_scan_feed> = 600.0
#<a_registration_feed> = 120.0

M5
G4 P3.0
G21 G90 G94 G17 G54

(Move from the verified center TMAG position to the measured +X index radius while scan is disarmed.)
M64 P0
G4 P2.0
G91 G1 X[#<outer_radius>] F[#<xy_travel_feed>]
G90

(Two-phase readiness handshake, then publish the TMAG threshold on PRB.)
M65 P0
G4 P2.0
o120 if [#<_probe_state> NE 1]
  M64 P0
  (print,P112 READY acknowledgement missing)
  o901 error[39]
o120 endif
M64 P0
G4 P0.10
o121 if [#<_probe_state> NE 0]
  (print,P112 READY acknowledgement did not release)
  o902 error[39]
o121 endif
M65 P0
G4 P0.10

(If the initial radius position happens to be over the index, first leave its footprint.)
o122 if [#<_probe_state> EQ 1]
  G91 G38.5 A[#<a_maximum_width>] F[#<a_scan_feed>]
  G90
  o123 if [#5070 NE 1]
    M64 P0
    (print,P112 could not leave initial A magnetic footprint)
    o903 error[39]
  o123 endif
o122 endif

(Pass one: find and leave the outer index footprint.)
G91 G38.3 A[#<a_search_degrees>] F[#<a_scan_feed>]
G90
o124 if [#5070 NE 1]
  M64 P0
  (print,P112 first A entry not found)
  o904 error[39]
o124 endif
(grblHAL #5064 is in the active G54 frame; convert each capture to G53 A.)
#<a_entry_1> = [#5064 + #5224]
G91 G38.5 A[#<a_maximum_width>] F[#<a_scan_feed>]
G90
o125 if [#5070 NE 1]
  M64 P0
  (print,P112 first A exit not found)
  o905 error[39]
o125 endif
#<a_exit_1> = [#5064 + #5224]

(Pass two: make the equivalent next-revolution observation.)
G91 G38.3 A[#<a_search_degrees>] F[#<a_scan_feed>]
G90
o126 if [#5070 NE 1]
  M64 P0
  (print,P112 second A entry not found)
  o906 error[39]
o126 endif
#<a_entry_2> = [#5064 + #5224]
G91 G38.5 A[#<a_maximum_width>] F[#<a_scan_feed>]
G90
o127 if [#5070 NE 1]
  M64 P0
  (print,P112 second A exit not found)
  o907 error[39]
o127 endif
#<a_exit_2> = [#5064 + #5224]

#<a_width_1> = ABS[#<a_exit_1> - #<a_entry_1>]
#<a_width_2> = ABS[#<a_exit_2> - #<a_entry_2>]
o128 if [[[#<a_width_1> LE 0] OR [#<a_width_1> GT #<a_maximum_width>]] OR [[#<a_width_2> LE 0] OR [#<a_width_2> GT #<a_maximum_width>]]]
  M64 P0
  (print,P112 A magnetic width outside limits)
  o908 error[39]
o128 endif

#<a_center_1> = [[#<a_entry_1> + #<a_exit_1>] / 2]
#<a_center_2> = [[#<a_entry_2> + #<a_exit_2>] / 2]
#<a_spacing> = [#<a_center_2> - #<a_center_1>]
o129 if [ABS[#<a_spacing> - #<a_expected_spacing>] GT #<a_spacing_tolerance>]
  M64 P0
  (print,P112 A index spacing validation failed)
  o909 error[39]
o129 endif

(Normalize pass two to pass one, then approach the pass-two magnetic center.)
#<a_index> = [[#<a_center_1> + [#<a_center_2> - #<a_expected_spacing>]] / 2]
#<a_pass_two_center> = [#<a_index> + [2 * #<a_expected_spacing>]]
G53 G1 A[#<a_pass_two_center>] F[#<a_registration_feed>]
M64 P0
(print,P112 survey complete: TMAG is at pass-two outer-index center; inspect MPos)
o112 return [1]
